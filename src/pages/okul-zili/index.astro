---
import OZLayout from '../../layouts/OZLayout.astro';
import release from '../../data/oz-release.json';

const packageLabels: Record<string, [string, string]> = {
  windows_installer: ['Windows kurulum', 'Önerilen · Başlat menüsü ve otomatik başlatma'],
  windows_portable: ['Windows taşınabilir', "Kurulum yapmadan veya USB'den kullanım"],
  linux_deb: ['Pardus / Debian', '.deb paketi · Yönetici parolası gerekir'],
  linux_archive: ['Pardus / Linux taşınabilir', 'Yönetici parolası olmadan kurulum'],
  checksums: ['SHA-256 özetleri', 'İndirilen dosyaları doğrulamak için'],
};

function formatBytes(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes <= 0) return '';
  const units = ['B', 'KB', 'MB', 'GB'];
  const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  return `${(bytes / 1024 ** index).toFixed(index > 1 ? 1 : 0)} ${units[index]}`;
}

const releaseAssets = release.assets as { kind: string; url: string; size?: number }[];
const assets = release.available ? releaseAssets.filter((asset) => packageLabels[asset.kind]) : [];
const releaseDate =
  release.available && release.published_at
    ? new Intl.DateTimeFormat('tr-TR', { dateStyle: 'long' }).format(new Date(release.published_at))
    : '';
---

<OZLayout
  title="Okul Zili — Çevrimdışı okul zili ve anons programı"
  description="Okul Zili; ders programını, tatilleri, törenleri ve güvenli ses yayınını çevrimdışı yöneten ücretsiz masaüstü uygulamasıdır."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Çevrimdışı · Windows ve Pardus · Okul bilgisayarında çalışır</p>
      <h1>Çevrimdışı okul zili ve anons programı.</h1>
      <p class="lead">
        Ders saatlerini bir kez tanımlarsınız; zilleri, teneffüsleri, öğle arasını,
        tatilleri ve özel günleri program yönetir.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#indir">Uygulamayı indir</a>
        <a class="button button-secondary" href="/okul-zili/kilavuz/">Kullanım kılavuzu</a>
      </div>
      <p class="privacy-promise">
        Hesap, bulut, reklam veya telemetri yok. Program ve günlükler yalnızca okul
        bilgisayarında tutulur.
      </p>
    </div>
    <aside class="hero-panel" aria-label="Program özeti">
      <div class="status-line"><span></span> Çevrimdışı çalışma</div>
      <div class="metric"><strong>Tekli / ikili eğitim</strong><span>ve blok ders desteği</span></div>
      <div class="metric"><strong>Resmî tatiller</strong><span>ve arife kuralları hazır gelir</span></div>
      <div class="metric"><strong>Windows + Pardus</strong><span>hedef platformlar</span></div>
    </aside>
  </section>

  <section class="section" id="ozellikler">
    <div class="section-heading">
      <p class="eyebrow">Özellikler</p>
      <h2>Program neler yapar?</h2>
      <p>
        Günlük kullanımı hızlandıran araçlarla, yayın güvenliğini koruyan önlemler
        aynı uygulamada.
      </p>
    </div>
    <div class="feature-grid">
      <article class="card"><span class="card-number">01</span><h3>Programı otomatik hesaplayın</h3><p>İlk ders, ders sayısı ve süresi, teneffüs ve öğle arası bilgileriyle günün tüm zil saatleri otomatik hesaplanır.</p></article>
      <article class="card"><span class="card-number">02</span><h3>İkili eğitim ve blok dersler</h3><p>Günler tekli ya da sabah/öğleden sonra iki oturumlu kurulur; <code>2+2+1+1</code> gibi blok desenlerinde blok içindeki ara ziller çalmaz. Blok içindeki ders sınırlarında beş saniyelik kısa bir sınıf değişim zili çalınabilir. Hazır düzeni seçtiğiniz günlere tek işlemde kopyalayın.</p></article>
      <article class="card"><span class="card-number">03</span><h3>Tatilde zil çalmasın</h3><p>Ders yılı, dönemler, ara tatiller ve Türkiye'nin sabit resmî tatilleri programın doğal parçasıdır.</p></article>
      <article class="card"><span class="card-number">04</span><h3>Öğrenci ve öğretmen zili</h3><p>İsterseniz öğrenci zilini etkinleştirin ve öğretmen zilinden kaç dakika önce çalacağını tek değerle belirleyin.</p></article>
      <article class="card"><span class="card-number">05</span><h3>Tören ve tatbikat merkezi</h3><p>İstiklâl Marşı, 10 Kasım akışı, AFAD'ın sarı, kırmızı ve KBRN ikazları ile okul içi tatbikat sirenleri ana ekrandadır; riskli yayınlar açık onay ister. Aynı güne birden çok tören planlanabilir; tören günün programını silmez, üzerine biner.</p></article>
      <article class="card"><span class="card-number">06</span><h3>Kesintisiz çalışma</h3><p>Ses cihazı, dosyalar ve sıradaki olay sürekli denetlenir; hatalar yedek bip sesi ve görünür uyarılarla yönetilir. Kaçırılan ya da bekletilen bir zil olursa genel durum paneli ve sistem tepsisi bunu saatiyle bildirir. Elektrik kesintisi sonrası bilgisayar açıldığında ziller kimsenin PIN girmesini beklemeden çalmaya devam eder; başından ayrılırken oturumu tek tıkla kilitleyebilirsiniz.</p></article>
      <article class="card"><span class="card-number">07</span><h3>Sesler pakette gelir</h3><p>MEB öğrenci, öğretmen ve teneffüs zilleri, marş seçenekleri ve ikaz kayıtları kurulumun içindedir; program hiçbir ses dosyasını internetten indirmez.</p></article>
      <article class="card"><span class="card-number">08</span><h3>Teneffüs müziği ve ses düzeyi</h3><p>Tek çubukla tüm yayınların ortak ses düzeyini ayarlayın. Teneffüste kamu malı bestelerden hafif müzik isteğe bağlıdır; sıradaki zilden önce kendiliğinden susar.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Kurulum</p>
      <h2>Üç adımda kurulur</h2>
    </div>
    <ol class="steps">
      <li><span>1</span><div><strong>Ders düzenini girin</strong><p>Başlangıç saati, ders ve teneffüs süreleri yeterli.</p></div></li>
      <li><span>2</span><div><strong>Takvimi doğrulayın</strong><p>Dönemleri, ara tatilleri ve özel günleri düzenleyin.</p></div></li>
      <li><span>3</span><div><strong>Sesi test edin</strong><p>Çıkış cihazını ve zil kayıtlarını güvenle deneyin.</p></div></li>
    </ol>
  </section>

  <section class="section download-section" id="indir">
    <div class="section-heading two-column-heading">
      <div>
        <p class="eyebrow">İndirme</p>
        <h2>Uygulamayı indirin</h2>
      </div>
      <p class="release-summary">
        {release.available
          ? `${release.prerelease ? 'Beta sürüm' : 'En yeni sürüm'}: ${release.version}`
          : 'İlk indirilebilir sürüm hazırlık aşamasında.'}
      </p>
    </div>

    {assets.length > 0 && (
      <div class="download-grid">
        {assets.map((asset) => (
          <article class="download-card">
            <h3>{packageLabels[asset.kind][0]}</h3>
            <p class="download-meta">
              {packageLabels[asset.kind][1]}{asset.size ? ` · ${formatBytes(asset.size)}` : ''}
            </p>
            <a class="button" href={asset.url} rel="noopener" aria-label={`${packageLabels[asset.kind][0]} paketini indir`}>
              İndir
            </a>
          </article>
        ))}
      </div>
    )}


    <div class="info-box">
      <p>
        <b>Kişisel bir çalışmadır.</b> Okul Zili, Millî Eğitim Bakanlığının resmî
        yazılımı değildir; okulda karşılaştığım bir ihtiyaçtan doğdu ve kişisel gelişim
        çalışması olarak sürdürülüyor. Eksikler olabilir: kurduğunuz çizelgeyi ve tatil
        takvimini okulunuzun kendi programıyla karşılaştırın, ilk günlerde zil
        saatlerini gözleyerek doğrulayın.
      </p>
    </div>

    <div class="security-note">
      <strong>Dosya bütünlüğü</strong>
      <p>
        Paketler bu sitenin kendi indirme alanından (indir.okulapp.org) sunulur; aynı
        dosyalar projenin resmî GitHub Releases sayfasında da yayımlanır. İndirdiğiniz
        dosyayı yayımlanan SHA-256 değeriyle doğrulamanız önerilir.
      </p>
      <a href="/okul-zili/kilavuz/#dosya-dogrulama">Nasıl doğrulanır? →</a>
    </div>

    <p class="github-fallback">
      İndirme bağlantıları MEB ağı gibi GitHub'ın engelli olduğu bağlantılarda da
      çalışır: paketler GitHub'dan değil, okulapp.org'un kendi indirme alanından gelir.
    </p>
  </section>

  <section class="section safety" id="guvenlik">
    <div>
      <p class="eyebrow">Yayın güvenliği</p>
      <h2>Yanlış yayına karşı alınan önlemler</h2>
    </div>
    <div class="safety-list">
      <p><strong>Merkezî durdurma</strong><span>Çalan zil, müzik veya senaryo tek düğmeyle anında kesilir.</span></p>
      <p><strong>Yayın onayı</strong><span>Tatbikat ve tören sesleri başlamadan önce kullanıcıdan açık onay alınır.</span></p>
      <p><strong>Tek oynatma kuyruğu</strong><span>İki sesin üst üste binmesi uygulama düzeyinde engellenir.</span></p>
      <p><strong>Çalışma denetimi</strong><span>Zaman, ses cihazı, dosyalar ve yaklaşan program düzenli kontrol edilir.</span></p>
    </div>
  </section>

  <section class="section updates" id="guncellemeler">
    <div class="section-heading">
      <p class="eyebrow">Güncellemeler</p>
      <h2>Sürüm notları</h2>
    </div>
    <div class="update-layout">
      <div>
        <p class="release-title">
          {release.available
            ? release.name || `Okul Zili ${release.version}`
            : 'İndirilebilir sürüm henüz yayımlanmadı'}
        </p>
        <p class="muted">
          {release.available && releaseDate
            ? releaseDate
            : 'Paketler hazır olduğunda burada görünür.'}
        </p>
      </div>
      <div>
        <p>
          Yeni özellikler, düzeltmeler ve indirilebilir paketler GitHub sürüm sayfasında
          açıkça yayımlanır.
        </p>
        <a class="text-link" href={release.releaseUrl} rel="noopener">Tüm sürüm notlarını görüntüle →</a>
      </div>
    </div>
  </section>

  <section class="section contact" id="iletisim">
    <div>
      <p class="eyebrow">İletişim</p>
      <h2>Bir öneriniz veya hata bildiriminiz mi var?</h2>
      <p>
        Teknik destek ve geliştirme önerileri için e-posta gönderebilir ya da GitHub
        üzerinde kayıt açabilirsiniz.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="mailto:aalidemirci@gmail.com?subject=Okul%20Zili%20hakkında">E-posta gönder</a>
        <a class="button button-outline" href="https://github.com/aalidemirci/okulzili/issues" rel="noopener">GitHub Issues</a>
      </div>
    </div>
    <aside class="warning-card">
      <strong>Günlük ve kurum bilgilerini paylaşmayın</strong>
      <p>
        Destek talebine okul adı, gerçek program, ses kaydı, günlük, yedek dosyası veya
        ekran görüntüsü eklemeyin. Sorunu kişisel ve kurumsal bilgi içermeyen örneklerle
        anlatın.
      </p>
      <a href="/okul-zili/gizlilik/">Gizlilik bilgilendirmesi →</a>
    </aside>
  </section>
</OZLayout>
