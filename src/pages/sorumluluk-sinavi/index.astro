---
import SSLayout from '../../layouts/SSLayout.astro';
import release from '../../data/ss-release.json';

const packageLabels: Record<string, [string, string]> = {
  windows_installer: ['Windows kurulum', 'Önerilen · Yönetici parolası gerekmez'],
  windows_portable: ['Windows taşınabilir', "Kurulum yapmadan veya USB'den kullanım"],
  linux_deb: ['Pardus / Debian', '.deb paketi · Yönetici parolası gerekir'],
  linux_archive: ['Pardus / Linux taşınabilir', 'Yönetici parolası olmadan kurulum'],
  checksums: ['SHA-256 özetleri', 'İndirilen dosyaları doğrulamak için'],
};

function formatBytes(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes <= 0) return '';
  const units = ['B', 'KB', 'MB', 'GB'];
  const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  return `${(bytes / 1024 ** index).toFixed(index > 1 ? 1 : 0)} ${units[index]}`;
}

const releaseAssets = release.assets as { kind: string; url: string; size?: number }[];
const assets = release.available ? releaseAssets.filter((asset) => packageLabels[asset.kind]) : [];
const releaseDate =
  release.available && release.published_at
    ? new Intl.DateTimeFormat('tr-TR', { dateStyle: 'long' }).format(new Date(release.published_at))
    : '';

// Örnek evrak: örnek okul ("Örnek Anadolu Lisesi") için programın kendisiyle
// üretilip PDF'e çevrilen belgeler; dosyalar public/sorumluluk-sinavi/ornek-evrak/.
// Üretici: sorumluluk-sinavi deposundaki araclar/site_ornekleri.py.
const ornekEvrak = [
  { ad: '01-sinav-programi', baslik: 'Sınav programı (öğrenci nüshası)', sayfa: 1, yatay: false,
    aciklama: 'Tarih, saat, ders, süre ve salon; müdür onay numarası ve OLUR satırıyla.' },
  { ad: '02-sinav-programi-gorevli', baslik: 'Sınav programı (görevli nüshası)', sayfa: 2, yatay: true,
    aciklama: 'Aynı program, komisyon üyeleri ve salon salon gözcülerle.' },
  { ad: '03-gorevlendirme-cizelgesi', baslik: 'Görevlendirme çizelgesi', sayfa: 4, yatay: true,
    aciklama: 'Müdür onayına sunulan olur yazısı; arkasında tebliğ-tebellüğ tablosu.' },
  { ad: '04-gorev-sayac-raporu', baslik: 'Öğretmen görev sayacı', sayfa: 2, yatay: true,
    aciklama: 'Üç dönemin komisyon ve gözcülük dökümü ve 12/15 durumu.' },
  { ad: '05-ilan-sinav-takvimi', baslik: 'İlan: sınav takvimi', sayfa: 1, yatay: false,
    aciklama: 'Okul sitesinde yayımlanır; kişisel veri içermez.' },
  { ad: '06-ilan-ogrenci-cizelgesi', baslik: 'İlan: öğrenci sınav çizelgesi', sayfa: 8, yatay: false,
    aciklama: 'Okul numarası ve maskeli ad; açık ad hiçbir seçenekte yazılmaz.' },
  { ad: '07-ilan-basvuru-duyurusu', baslik: 'İlan: başvuru duyurusu', sayfa: 1, yatay: false,
    aciklama: 'Beklemeli ve devamsız öğrencilerin yazılı başvurusu (OKY md.58/2-d).' },
  { ad: '08-basvuru-plan-disi-tutanagi', baslik: 'Plan dışı bırakılanlar tutanağı', sayfa: 1, yatay: false,
    aciklama: 'Başvurusu olmadığı için plana alınmayanlar; okul içi kayıttır, ilan edilmez.' },
  { ad: '09-kisi-bazli-gorev-cizelgesi', baslik: 'Kişi bazlı görev çizelgesi', sayfa: 3, yatay: true,
    aciklama: 'Her öğretmenin görevleri tarih, saat ve salonla tek satırda; tebellüğ imzasıyla.' },
];
---

<SSLayout
  title="Sorumluluk Sınavı — Çevrimdışı sınav planı ve görevlendirme programı"
  description="Sorumluluk Sınavı; ortaöğretim kurumlarında sorumluluk sınavı planını, komisyon ve gözcü görevlendirmesini ve sınav evrakını çevrimdışı hazırlayan ücretsiz masaüstü uygulamasıdır."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Çevrimdışı · Hiçbir ağ isteği yapmaz · e-Okul'a bağlanmaz</p>
      <h1>Sınav planını ve görevlendirmeyi hazırlayan çevrimdışı program.</h1>
      <p class="lead">
        e-Okul raporlarını içe aktarın; program sınav oturumlarını günlere ve saatlere
        yerleştirsin, komisyon ve gözcüleri görevlendirsin, ilan ve görevlendirme
        evrakını hazırlasın.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#indir">Uygulamayı indir</a>
        <a class="button button-secondary" href="/sorumluluk-sinavi/kilavuz/">Kullanım kılavuzu</a>
      </div>
      <p class="privacy-promise">
        Program e-Okul, MEBBİS veya DYS'ye bağlanmaz, kullanıcı adı ve şifre istemez.
        Yalnız sizin dışa aktardığınız dosyaları okur; veri okulun bilgisayarında kalır.
      </p>
    </div>
    <aside class="hero-panel" aria-label="Program özeti">
      <div class="status-line"><span></span> Çevrimdışı çalışma</div>
      <div class="metric"><strong>9 belge</strong><span>program, çizelge, ilan ve tutanak</span></div>
      <div class="metric"><strong>20 kural</strong><span>her birinin dayanağı yazılı</span></div>
      <div class="metric"><strong>Eylül · Şubat · Haziran</strong><span>üç dönem, taşınan görev sayacı</span></div>
    </aside>
  </section>

  <section class="section" id="ozellikler">
    <div class="section-heading">
      <p class="eyebrow">Özellikler</p>
      <h2>Program neler yapar?</h2>
      <p>
        Sorumluluk sınavında zor olan, sınavı bir güne koymak değil; o saatte komisyonu
        kurabilmek. Program ikisini tek problem olarak çözer.
      </p>
    </div>
    <div class="feature-grid">
      <article class="card"><span class="card-number">01</span><h3>e-Okul raporundan başlar</h3><p>Personel listesi (<code>OOK01001R1</code>) ve sorumluluk listesi (<code>OOK12001R010</code>) içe aktarılır; branş havuzu personel raporundan kurulur. Dosya yanlış biçimdeyse program sessizce yanlış okumaz, hangi başlığı bulamadığını söyleyerek durur.</p></article>
      <article class="card"><span class="card-number">02</span><h3>Plan ve görevlendirme birlikte</h3><p>Oturumun nereye konabileceği, o saatte komisyonun kurulup kurulamayacağına bağlıdır. İkisi birlikte çözüldüğü için aynı saatte birden çok sınav yapılabilir ve program az sayıda güne sığar. Kalabalık sınav salonlara bölünür, her salona ayrı gözcü konur.</p></article>
      <article class="card"><span class="card-number">03</span><h3>Gün sayısını kendisi seçer</h3><p>Öğrencilerin çoğunluğunun sığdığı en kısa program denenir: bir hafta, olmazsa iki hafta. Bir öğrencinin bir günde ikiyi aşan sınavı uyarı, üçü aşan sınavı engel olarak gösterilir (ÖDY md.5/1-k); sığmayan öğrencinin sınırı en çok üçe çıkar ve adıyla raporlanır.</p></article>
      <article class="card"><span class="card-number">04</span><h3>Sürükle-bırak düzenleme</h3><p>Kartı başka bir güne taşıyın; öğrenci, öğretmen ve salon çakışmaları ayrı ayrı denetlenir, engel doğuran taşıma geri alınır. İki aşamalı dersin uygulaması yazılıdan ayrı bir güne alınabilir. Plan siz kaydedene kadar veritabanına yazılmaz.</p></article>
      <article class="card"><span class="card-number">05</span><h3>Tatil ve öğretmen müsaitliği</h3><p>Resmî tatil ve idari izin günlerine sınav konmaz; başvuru ve evrak teslim süreleri bu günleri iş günü saymaz. Öğretmenin dersi, izni ya da başka görevi olan saatlerine görev verilmez (OKY md.58/2-ç).</p></article>
      <article class="card"><span class="card-number">06</span><h3>Görevliyi elle değiştirme</h3><p>Takvimde sınava tıklayınca görevliler görünür. Yerine gelebilecek öğretmenler uygunluk gerekçeleriyle listelenir. Kesinleşmiş planda değişiklik müdür onay numarası ve gerekçeyle kaydedilir, görevlendirme çizelgesinde de yazılır.</p></article>
      <article class="card"><span class="card-number">07</span><h3>Tek ders sınavı</h3><p>Sorumluluk sınavından sonra tek dersten başarısız kalan 12. sınıf öğrencisi için takip eden haftaya ayrı plan kurulur (OKY md.58/6). Aynı kurallar ve aynı evrak geçerlidir.</p></article>
      <article class="card"><span class="card-number">08</span><h3>Görev dengesi ve ücret sınırı</h3><p>Görev sayaçları üç dönem arasında taşınır; çok görev almış öğretmen sonraki dönemde geri plana düşer. Yıllık 12 komisyon / 15 gözcülük sınırı görev tarihine göre izlenir; toplu sözleşme gereği 2024–2027 görevlerinde uygulanmaz.</p></article>
      <article class="card"><span class="card-number">09</span><h3>Resmî yazışma biçiminde evrak</h3><p>Belgeler "T.C. / Kaymakamlık / Okul Müdürlüğü" başlığıyla, Times New Roman ve siyah-beyaz baskıya uygun üretilir. İmza bloğunda düzenleyen ve OLUR satırı yer alır. Kişi bazlı görev çizelgesinde her öğretmenin görevleri tek satırda toplanır.</p></article>
      <article class="card"><span class="card-number">10</span><h3>KVKK uyumlu ilan çıktıları</h3><p>Okul web sayfasında yayımlanacak üç belge ayrı üretilir. Sınav takviminde ve başvuru duyurusunda kişisel veri yoktur. Öğrenci çizelgesinde ad ve soyadı hiçbir seçenekte açık yazılmaz; okul numarası ve maskeli ad gösterilir.</p></article>
      <article class="card"><span class="card-number">11</span><h3>Başvuru kapısı</h3><p>Beklemeli ve devamsız öğrenciler otomatik plana alınmaz; yazılı başvuruları hâlinde dâhil edilir (OKY md.58/2-d). Başvuru duyurusu ve plan dışı bırakılanlar tutanağı program tarafından üretilir.</p></article>
      <article class="card"><span class="card-number">12</span><h3>Evrak teslim takibi</h3><p>Sınavdan sonra komisyondan geri alınacak evrak oturum başına izlenir. Teslim süresi sınav tarihini izleyen ilk iş günüdür; süresinde gelmeyen evrak çizelgede kırmızı görünür.</p></article>
    </div>
  </section>

  <section class="section" id="ekranlar">
    <div class="section-heading">
      <p class="eyebrow">Ekranlar</p>
      <h2>Programdan görünümler</h2>
    </div>
    <p class="shots-note">
      Görüntüler tanıtım için kurulmuş <b>örnek bir okula</b> ("Örnek Anadolu Lisesi")
      aittir; numaralar örnektir. Kişi adlarının yerinde "Adı Soyadı" ya da "Matematik
      Öğretmeni 1" gibi görev adları yazar. Görüntüler 0.6.2 sürümünden, Pardus'un tabanı
      olan Debian 12 ortamında alındı; Windows'ta yazı tipi farklıdır.
    </p>
    <div class="shots-grid">
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-sinav-plani.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Sınav planı ekranı: üç günlük takvimde paralel sınav kartları; seçili matematik sınavının iki salonu, komisyonu ve salon salon gözcüleri alttaki şeritte." />
        <figcaption>
          <strong>Sınav planı</strong>
          Plan ve görevlendirme birlikte üretilir; aynı saatte birden çok sınav yapılabilir.
          Karta tıklayınca komisyon ve gözcüler görünür. 38 öğrencili sınav iki salona
          bölünmüş, her salona ayrı gözcü konmuş.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-gorevli-degistir.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Görevliyi değiştir penceresi: sınavın görevlileri, yerine gelebilecek öğretmenler görev sayıları ve uygunluk durumlarıyla, gerekçe ve müdür onay numarası alanları." />
        <figcaption>
          <strong>Görevliyi değiştirme</strong>
          Uygun adaylar üstte, görev yükü az olan önde listelenir; uygun olmayanlar
          nedeniyle görünür. Kesinleşmiş planda değişiklik müdür onay numarası ve
          gerekçeyle kaydedilir.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-basvuru.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Başvuru ekranı: duyuru tarihi ve son başvuru günü, beklemeli ve devamsız öğrencilerin başvuru durumlarını gösteren tablo." />
        <figcaption>
          <strong>Başvuru</strong>
          Mezun olamayan ve devamsızlık tebligatı yapılan öğrenciler yazılı başvuruyla plana
          girer (OKY md.58/2-d). Son başvuru günü 5 iş günü kuralına göre denetlenir;
          duyuru ilanı ve plan dışı tutanağı buradan üretilir.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-teslim-cizelgesi.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Teslim çizelgesi: her sınavın kâğıtları, komisyon tutanağı ve yoklama listesi; teslim alınanlar yeşil, gecikenler kırmızı." />
        <figcaption>
          <strong>Evrak teslim takibi</strong>
          Sınavdan sonra komisyondan geri alınacak evrak oturum başına izlenir. Teslim
          süresi sınavı izleyen ilk iş günüdür; süresinde gelmeyen evrak kırmızı görünür.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-kurum-ayarlari.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Kurum ayarları ekranı: okul bilgileri, dönem tarihleri, evrak anteti ve tatil günleri listesi." />
        <figcaption>
          <strong>Kurum ayarları ve tatil günleri</strong>
          Dönem tarihlerinden üç sınav penceresi hesaplanır. Evrak anteti ilçeden türetilir.
          Tatil ve idari izin günlerine sınav konmaz. Veritabanı yedeği de buradan alınır.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-musaitlik.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Öğretmen müsaitliği penceresi: her hafta tekrar eden dolu saatler ve tarih aralıklı izin ya da görev kayıtları." />
        <figcaption>
          <strong>Öğretmen müsaitliği</strong>
          Dersi, izni ya da başka görevi olan saatler girilir; planlayıcı bu saatlere görev
          vermez (OKY md.58/2-ç). Açıklamaya sağlık bilgisi yazılmaz.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-tek-ders.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Tek ders sınavı penceresi: olağan plandaki 12. sınıf öğrencileri ve dersleri, seçilen tek ders işaretli." />
        <figcaption>
          <strong>Tek ders sınavı</strong>
          Olağan plandaki 12. sınıf öğrencilerinden başarısız kalınan tek ders seçilir;
          program takip eden haftaya ayrı plan kurar (OKY md.58/6). Sonuçlar e-Okul'dan
          okunur, program sonucu bilmez.
        </figcaption>
      </figure>
      <figure class="shot">
        <img src="/sorumluluk-sinavi/ekran-ders-brans.webp" width="1440" height="900" loading="lazy" decoding="async"
          alt="Ders ve branş eşleştirme ekranı: her dersin branşı, iki aşamalı olup olmadığı ve sorumluluk kaydı sayısı." />
        <figcaption>
          <strong>Ders / branş</strong>
          Her ders bir alan branşına eşlenir. Türk dili ve edebiyatı ile yabancı diller iki
          aşamalı (yazılı ve uygulama) işaretlenir (OKY md.58/2-e).
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="ornek-evrak">
    <div class="section-heading">
      <p class="eyebrow">Örnek evrak</p>
      <h2>Programın ürettiği belgeler</h2>
    </div>
    <p class="shots-note">
      Aşağıdaki belgeler aynı örnek okul için programın kendisiyle üretildi; imza
      yerlerinde "Adı SOYADI", öğretmen adlarının yerinde görev adları yazar. Program
      belgeleri <code>.docx</code> olarak verir, burada inceleme kolaylığı için PDF'e
      çevrildi. Önizlemede ilk sayfa görünür.
    </p>
    <div class="docs-grid">
      {ornekEvrak.map((belge) => (
        <article class="doc-card">
          <a class="doc-preview" href={`/sorumluluk-sinavi/ornek-evrak/${belge.ad}.pdf`} aria-label={`${belge.baslik} (PDF, ${belge.sayfa} sayfa)`}>
            <img src={`/sorumluluk-sinavi/ornek-evrak/${belge.ad}.webp`} width={belge.yatay ? 1287 : 910} height={belge.yatay ? 910 : 1287}
              loading="lazy" decoding="async" alt="" />
          </a>
          <div class="doc-body">
            <h3>{belge.baslik}</h3>
            <p>{belge.aciklama}</p>
            <a class="text-link" href={`/sorumluluk-sinavi/ornek-evrak/${belge.ad}.pdf`}>PDF · {belge.sayfa} sayfa →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Sıra önemli</p>
      <h2>Her adım bir sonrakinin girdisi</h2>
    </div>
    <ol class="steps">
      <li><span>1</span><div><strong>Kurum ve dönem</strong><p>Okul bilgileri, üç dönemin tarihleri ve tatil günleri. Sınav pencereleri bu tarihlerden hesaplanır.</p></div></li>
      <li><span>2</span><div><strong>Öğretmen, salon, başvuru, ders</strong><p>Personel raporu ve müsaitlik, salon kapasiteleri, öğrenci listesi ve başvurular, ders-branş eşlemesi. İki aşamalı dersler burada işaretlenir.</p></div></li>
      <li><span>3</span><div><strong>Plan ve evrak</strong><p>Planı üretin, gerekirse elle düzenleyin, müdür onayıyla kesinleştirin; belgeleri .docx olarak alın.</p></div></li>
    </ol>
  </section>

  <section class="section download-section" id="indir">
    <div class="section-heading two-column-heading">
      <div>
        <p class="eyebrow">İndirme</p>
        <h2>Uygulamayı indirin</h2>
      </div>
      <p class="release-summary">
        {release.available
          ? `${release.prerelease ? 'Beta sürüm' : 'En yeni sürüm'}: ${release.version}`
          : 'İlk indirilebilir sürüm hazırlık aşamasında.'}
      </p>
    </div>

    {assets.length > 0 && (
      <div class="download-grid">
        {assets.map((asset) => (
          <article class="download-card">
            <h3>{packageLabels[asset.kind][0]}</h3>
            <p class="download-meta">
              {packageLabels[asset.kind][1]}{asset.size ? ` · ${formatBytes(asset.size)}` : ''}
            </p>
            <a class="button" href={asset.url} rel="noopener" aria-label={`${packageLabels[asset.kind][0]} paketini indir`}>
              İndir
            </a>
          </article>
        ))}
      </div>
    )}


    <div class="info-box">
      <p>
        <b>Kişisel bir çalışmadır.</b> Sorumluluk Sınavı, Millî Eğitim Bakanlığının
        resmî yazılımı değildir; okulda karşılaştığım bir ihtiyaçtan doğdu ve kişisel
        gelişim çalışması olarak sürdürülüyor. Eksikler olabilir: ürettiği planı ve
        evrakı ilan etmeden önce kontrol edin. Kuralların dayandığı maddeler bu
        sayfanın Mevzuat bölümünde yazılıdır; bilmediğiniz hükmü kaynağından doğrulayın.
      </p>
    </div>

    <div class="security-note">
      <strong>Dosya güvenliği</strong>
      <p>
        Paketler bu sitenin kendi indirme alanından (indir.okulapp.org) sunulur; aynı
        dosyalar projenin resmî GitHub Releases sayfasında da yayımlanır. Windows kurulumu
        kullanıcı başınadır: yönetici parolası istemez, Program Files'a yazmaz. Pardus
        paketi yönetici parolası ister ama verinin durduğu yere dokunmaz. Her iki kurulum
        da mevcut veritabanınızı olduğu gibi bırakır. İndirdiğiniz dosyayı yayımlanan
        SHA-256 değeriyle doğrulamanız önerilir.
      </p>
      <a href="/sorumluluk-sinavi/kilavuz/#dosya-dogrulama">Dosya doğrulama adımları →</a>
    </div>

    <p class="github-fallback">
      İndirme bağlantıları MEB ağı gibi GitHub'ın engelli olduğu bağlantılarda da
      çalışır: paketler GitHub'dan değil, okulapp.org'un kendi indirme alanından gelir.
      Okulda 0.3.0 kurulu ise üzerine en yeni sürümü kurun — 0.3.0 numarasıyla iki
      farklı paket derlendi, hangi içeriği taşıdığı ayırt edilemiyor. Yükseltme önce
      kaldırmayı gerektirmez ve kurulum veritabanına dokunmaz. 0.6 sürümü ilk açılışta
