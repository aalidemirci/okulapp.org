---
import KSLayout from '../../layouts/KSLayout.astro';
import release from '../../data/ks-release.json';

const packageLabels: Record<string, [string, string]> = {
  windows_installer: ['Windows kurulum', 'Önerilen · Yönetici parolası gerekmez'],
  windows_portable: ['Windows taşınabilir', "Kurulum yapmadan veya USB'den kullanım"],
  linux_deb: ['Pardus / Debian', '.deb paketi · Yönetici parolası gerekir'],
  linux_archive: ['Pardus / Linux taşınabilir', 'Yönetici parolası olmadan kurulum'],
  checksums: ['SHA-256 özetleri', 'İndirilen dosyaları doğrulamak için'],
};

function formatBytes(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes <= 0) return '';
  const units = ['B', 'KB', 'MB', 'GB'];
  const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  return `${(bytes / 1024 ** index).toFixed(index > 1 ? 1 : 0)} ${units[index]}`;
}

const releaseAssets = release.assets as { kind: string; url: string; size?: number }[];
const assets = release.available ? releaseAssets.filter((asset) => packageLabels[asset.kind]) : [];
const releaseDate =
  release.available && release.published_at
    ? new Intl.DateTimeFormat('tr-TR', { dateStyle: 'long' }).format(new Date(release.published_at))
    : '';
---

<KSLayout
  title="Kelebek Sınav — Çevrimdışı ortak sınav planlama programı"
  description="Kelebek Sınav; ortak yazılı sınavların takvimini kuran, öğrencileri kelebek düzeniyle salonlara dağıtan ve salon evrakını hazırlayan ücretsiz masaüstü uygulamasıdır."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Okul bilgisayarında çalışır · Veri buluta gitmez</p>
      <h1>Ortak sınavın takvimini kurar, öğrencileri salonlara oturtur.</h1>
      <p class="lead">
        Sınav takvimini mevzuat pencerelerine göre hazırlar, öğrencileri kelebek
        düzeniyle salonlara dağıtır ve sınav günü gereken evrakı basıma hazır
        çıkarır. Ortaöğretim kurumları için, tek bilgisayarda çalışan masaüstü
        programı.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#indir">Uygulamayı indir</a>
        <a class="button button-secondary" href="/kelebek-sinav/kilavuz/">Kullanım kılavuzu</a>
      </div>
      <p class="privacy-promise">
        Öğrenci ve personel kayıtları cihazınızdan çıkmaz. Site; çerez, reklam ve ziyaretçi
        analizi kullanmaz.
      </p>
    </div>
    <aside class="hero-panel" aria-label="Program özeti">
      <div class="status-line"><span></span> Çevrimdışı çalışma</div>
      <div class="metric"><strong>6</strong><span>sınav evrakı türü</span></div>
      <div class="metric"><strong>Salon başına 1 kâğıt</strong><span>kroki, yoklama, sayım ve teslim tek belgede</span></div>
      <div class="metric"><strong>Windows + Pardus</strong><span>kurulum seçenekleri</span></div>
    </aside>
  </section>

  <section class="section" id="ozellikler">
    <div class="section-heading">
      <p class="eyebrow">Özellikler</p>
      <h2>Program neler yapar?</h2>
    </div>
    <div class="feature-grid">
      <article class="card"><span class="card-number">01</span><h3>Kelebek düzen dağıtımı</h3><p>Aynı sınava giren öğrenciler yan yana düşmez. Dağıtım deterministiktir: aynı girdi her zaman aynı planı verir.</p></article>
      <article class="card"><span class="card-number">02</span><h3>Bağımsız doğrulama</h3><p>Üretilen plan ayrı bir doğrulayıcıdan geçer; tek bir kural ihlali kalırsa oturum onaylanmaz.</p></article>
      <article class="card"><span class="card-number">03</span><h3>Otomatik sınav takvimi</h3><p>Havuzdaki sınavlar hafta içi günlere ve okulun sınav saatlerine dağıtılır; günlük sınav sınırı ve üst makam sınav günleri gözetilir.</p></article>
      <article class="card"><span class="card-number">04</span><h3>Sınav günü evrakı</h3><p>Oturma planı krokisi, yoklama, evrak sayımı ve teslim zinciri tek belgede; şube duyurusu, tutanak ve görevlendirme yazısı ayrıca.</p></article>
      <article class="card"><span class="card-number">05</span><h3>Ders havuzu ve şubeler</h3><p>Ders listesi okul türünüzün yürürlükteki haftalık ders çizelgesinden türetilir; seçmeliyi hangi şubelerin aldığı bir kez tanımlanır.</p></article>
      <article class="card"><span class="card-number">06</span><h3>Çevrimdışı ve şifreli</h3><p>Veriler tek bir yerel dosyada durur. Uygulama parolası kurulursa ad alanları diskte şifrelenir; yedek de şifreli alınır.</p></article>
    </div>
  </section>

  <section class="section download-section" id="indir">
    <div class="section-heading two-column-heading">
      <div>
        <p class="eyebrow">İndirme</p>
        <h2>Uygulamayı indirin</h2>
      </div>
      <p class="release-summary">
        {release.available
          ? `${release.prerelease ? 'Beta sürüm' : 'En yeni sürüm'}: ${release.version}`
          : 'İlk indirilebilir sürüm hazırlık aşamasında.'}
      </p>
    </div>

    {assets.length > 0 && (
      <div class="download-grid">
        {assets.map((asset) => (
          <article class="download-card">
            <h3>{packageLabels[asset.kind][0]}</h3>
            <p class="download-meta">
              {packageLabels[asset.kind][1]}{asset.size ? ` · ${formatBytes(asset.size)}` : ''}
            </p>
            <a class="button" href={asset.url} rel="noopener" aria-label={`${packageLabels[asset.kind][0]} paketini indir`}>
              İndir
            </a>
          </article>
        ))}
      </div>
    )}

    <div class="info-box">
      <p>
        <b>Kişisel bir çalışmadır.</b> Kelebek Sınav, Millî Eğitim Bakanlığının resmî
        yazılımı değildir; okulda karşılaştığım bir ihtiyaçtan doğdu ve kişisel gelişim
        çalışması olarak sürdürülüyor. <b>Beta sürümdür:</b> gerçek öğrenci verisiyle
        kullanmadan önce yedek alın. Ürettiği oturma planlarını, takvimi ve evrakı,
        dayandığı mevzuat hükümlerini bilmiyorsanız araştırarak, biliyorsanız kontrol
        ederek kullanın; sorumluluk evrakı imzalayandadır.
      </p>
    </div>

    <div class="security-note">
      <strong>Dosya güvenliği</strong>
      <p>
        Dosyalar bu sitenin kendi indirme alanından (indir.okulapp.org) sunulur; aynı
        dosyalar projenin resmî GitHub Releases sayfasında da yayımlanır. İndirdikten
        sonra yayımlanan SHA-256 özetiyle doğrulamanız önerilir.
      </p>
      <a href="/kelebek-sinav/kilavuz/#dosya-dogrulama">Dosya doğrulama adımları →</a>
    </div>

    <p class="github-fallback">
      İndirme bağlantıları MEB ağı gibi GitHub'ın engelli olduğu bağlantılarda da
      çalışır. GitHub'a erişebiliyorsanız paketleri
      <a href={release.releaseUrl} rel="noopener">GitHub Releases</a> sayfasından da indirebilirsiniz.
    </p>
  </section>

  <section class="section updates" id="guncellemeler">
    <div class="section-heading">
      <p class="eyebrow">Güncellemeler</p>
      <h2>Sürüm notları</h2>
    </div>
    <div class="update-layout">
      <div>
        <p class="release-title">
          {release.available
            ? release.name || `Kelebek Sınav ${release.version}`
            : 'İndirilebilir sürüm henüz yayımlanmadı'}
        </p>
        <p class="muted">
          {release.available && releaseDate
            ? releaseDate
            : 'Paketler güvenlik kontrollerinden sonra burada görünür.'}
        </p>
      </div>
      <div>
        <p>Yeni özellikler, düzeltmeler ve bilinen sorunlar sürüm sayfasında açıkça yayımlanır.</p>
        <a class="text-link" href={release.releaseUrl} rel="noopener">Tüm sürüm notlarını görüntüle →</a>
      </div>
    </div>
  </section>

  <section class="section contact" id="iletisim">
    <div>
      <p class="eyebrow">İletişim</p>
      <h2>Bir sorun veya öneriniz mi var?</h2>
      <p>Teknik destek, öneri ve hata bildirimleri için e-posta gönderebilirsiniz.</p>
      <a class="button button-primary" href="mailto:aalidemirci@gmail.com?subject=Kelebek%20Sınav%20hakkında">E-posta gönder</a>
    </div>
    <aside class="warning-card">
      <strong>Kişisel veri göndermeyin</strong>
      <p>
        E-postaya veya herkese açık GitHub kayıtlarına öğrenci/personel adı, T.C. kimlik
        numarası, telefon, adres, ekran görüntüsü, yedek ya da günlük dosyası eklemeyin.
      </p>
      <a href="/kelebek-sinav/gizlilik/">Gizlilik ve KVKK bilgilendirmesi →</a>
    </aside>
  </section>
</KSLayout>
