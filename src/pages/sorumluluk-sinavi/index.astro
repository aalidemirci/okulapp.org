---
import SSLayout from '../../layouts/SSLayout.astro';
import release from '../../data/ss-release.json';

const packageLabels: Record<string, [string, string]> = {
  windows_installer: ['Windows kurulum', 'Önerilen · Yönetici parolası gerekmez'],
  windows_portable: ['Windows taşınabilir', "Kurulum yapmadan veya USB'den kullanım"],
  linux_deb: ['Pardus / Debian', '.deb paketi · Yönetici parolası gerekir'],
  linux_archive: ['Pardus / Linux taşınabilir', 'Yönetici parolası olmadan kurulum'],
  checksums: ['SHA-256 özetleri', 'İndirilen dosyaları doğrulamak için'],
};

function formatBytes(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes <= 0) return '';
  const units = ['B', 'KB', 'MB', 'GB'];
  const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  return `${(bytes / 1024 ** index).toFixed(index > 1 ? 1 : 0)} ${units[index]}`;
}

const releaseAssets = release.assets as { kind: string; url: string; size?: number }[];
const assets = release.available ? releaseAssets.filter((asset) => packageLabels[asset.kind]) : [];
const releaseDate =
  release.available && release.published_at
    ? new Intl.DateTimeFormat('tr-TR', { dateStyle: 'long' }).format(new Date(release.published_at))
    : '';
---

<SSLayout
  title="Sorumluluk Sınavı — Planı da görevlendirmeyi de program yapsın"
  description="Sorumluluk Sınavı; ortaöğretim kurumlarında sorumluluk sınavı planını, komisyon ve gözcü görevlendirmesini ve sınav evrakını çevrimdışı hazırlayan ücretsiz masaüstü uygulamasıdır."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Çevrimdışı · Hiçbir ağ isteği yapmaz · e-Okul'a bağlanmaz</p>
      <h1>Sorumluluk sınavı planı, komisyonuyla birlikte tek seferde çıksın.</h1>
      <p class="lead">
        e-Okul raporlarını içe aktarın; program sınav oturumlarını günlere ve saatlere
        yerleştirsin, komisyon ve gözcüleri görevlendirsin, ilan ve görevlendirme
        evrakını hazırlasın.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#indir">Uygulamayı indir</a>
        <a class="button button-secondary" href="/sorumluluk-sinavi/kilavuz/">Kullanım kılavuzu</a>
      </div>
      <p class="privacy-promise">
        Program e-Okul, MEBBİS veya DYS'ye bağlanmaz, kullanıcı adı ve şifre istemez.
        Yalnız sizin dışa aktardığınız dosyaları okur; veri okulun bilgisayarında kalır.
      </p>
    </div>
    <aside class="hero-panel" aria-label="Program özeti">
      <div class="status-line"><span></span> Çevrimdışı çalışma</div>
      <div class="metric"><strong>8 belge</strong><span>program, çizelge, ilan ve tutanak</span></div>
      <div class="metric"><strong>18 kural</strong><span>her biri mevzuat maddesine bağlı</span></div>
      <div class="metric"><strong>Eylül · Şubat · Haziran</strong><span>üç dönem, taşınan görev sayacı</span></div>
    </aside>
  </section>

  <section class="section" id="ozellikler">
    <div class="section-heading">
      <p class="eyebrow">Neler sunuyor?</p>
      <h2>Çizelgeyi elle kurmaya son</h2>
      <p>
        Sorumluluk sınavında zor olan, sınavı bir güne koymak değil; o saatte komisyonu
        kurabilmek. Program ikisini tek problem olarak çözer.
      </p>
    </div>
    <div class="feature-grid">
      <article class="card"><span class="card-number">01</span><h3>e-Okul raporundan başlar</h3><p>Personel listesi (<code>OOK01001R1</code>) ve sorumluluk listesi (<code>OOK12001R010</code>) içe aktarılır; branş havuzu personel raporundan kurulur. Dosya yanlış biçimdeyse program sessizce yanlış okumaz, hangi başlığı bulamadığını söyleyerek durur.</p></article>
      <article class="card"><span class="card-number">02</span><h3>Plan ve görevlendirme birlikte</h3><p>Oturumun nereye konabileceği, o saatte komisyonun kurulup kurulamayacağına bağlıdır. İkisi birlikte çözüldüğü için aynı saatte birden çok sınav yapılabilir ve program az sayıda güne sığar.</p></article>
      <article class="card"><span class="card-number">03</span><h3>Gün sayısını kendisi seçer</h3><p>Öğrencilerin çoğunluğunun sığdığı en kısa program denenir: bir hafta, olmazsa iki hafta. Pencereye sığmayan tek tük öğrencinin günlük sınırı gereken en düşük değere çıkarılır ve raporlanır.</p></article>
      <article class="card"><span class="card-number">04</span><h3>Sürükle-bırak düzenleme</h3><p>Kartı başka bir güne taşıyın; öğrenci, öğretmen ve salon çakışmaları ayrı ayrı denetlenir, engel doğuran taşıma geri alınır ve kimin çakıştığı yazılır. Geri al / ileri al vardır; plan siz kaydedene kadar veritabanına yazılmaz.</p></article>
      <article class="card"><span class="card-number">05</span><h3>Görev dengesi ve sayaç</h3><p>Görev sayaçları üç dönem arasında taşınır: ikinci dönem planlanırken birinci dönemde çok görev almış öğretmen geri plana düşer. Rapor, bir branşta yükün kaçınılmaz olarak biriktiği durumu da görünür kılar.</p></article>
      <article class="card"><span class="card-number">06</span><h3>KVKK uyumlu ilan çıktıları</h3><p>Okul web sayfasında yayımlanacak iki belge ayrı üretilir. Sınav takviminde hiçbir kişisel veri yoktur; öğrenci çizelgesinde ad ve soyadı hiçbir seçenekte açık yazılmaz, okul numarası ve maskeli ad gösterilir.</p></article>
      <article class="card"><span class="card-number">07</span><h3>Başvuru kapısı</h3><p>Beklemeli ve devamsız öğrenciler otomatik plana alınmaz; yazılı başvuruları hâlinde dâhil edilir (OKY md.58/2-d). Başvuru duyurusu ve plan dışı bırakılanlar tutanağı program tarafından üretilir.</p></article>
      <article class="card"><span class="card-number">08</span><h3>Evrak teslim takibi</h3><p>Sınavdan sonra komisyondan geri alınacak evrak oturum başına izlenir. Teslim süresi sınav tarihini izleyen ilk iş günüdür; süresinde gelmeyen evrak çizelgede kırmızı görünür.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Sıra önemli</p>
      <h2>Her adım bir sonrakinin girdisi</h2>
    </div>
    <ol class="steps">
      <li><span>1</span><div><strong>Kurum ve dönem</strong><p>Okul bilgileri ve üç dönemin tarihleri. Sınav pencereleri bu tarihlerden hesaplanır.</p></div></li>
      <li><span>2</span><div><strong>Öğretmen, salon, ders</strong><p>Personel raporu, salon kapasiteleri ve ders-branş eşlemesi. İki aşamalı dersler burada işaretlenir.</p></div></li>
      <li><span>3</span><div><strong>Plan ve evrak</strong><p>Planı üretin, gerekirse elle düzenleyin, müdür onayıyla kesinleştirin; belgeleri .docx olarak alın.</p></div></li>
    </ol>
  </section>

  <section class="section download-section" id="indir">
    <div class="section-heading two-column-heading">
      <div>
        <p class="eyebrow">Resmî paketler</p>
        <h2>Uygulamayı indirin</h2>
      </div>
      <p class="release-summary">
        {release.available
          ? `${release.prerelease ? 'Beta sürüm' : 'En yeni sürüm'}: ${release.version}`
          : 'İlk indirilebilir sürüm hazırlık aşamasında.'}
      </p>
    </div>

    <div class="drive-card">
      <div>
        <h3>MEB ağından indirme</h3>
        <p>
          Bu projenin paketleri şimdilik yalnızca GitHub üzerinden sunuluyor; GitHub'ın
          engellendiği okul ağlarında bağlantılar açılmaz. Sitenin kendi indirme alanına
          (indir.okulapp.org) taşınması bekliyor. O zamana kadar dosyayı GitHub'a
          erişebilen bir bağlantıdan indirip okul bilgisayarına taşımanız gerekir.
        </p>
      </div>
    </div>

    {assets.length > 0 && (
      <div class="download-grid">
        {assets.map((asset) => (
          <article class="download-card">
            <h3>{packageLabels[asset.kind][0]}</h3>
            <p class="download-meta">
              {packageLabels[asset.kind][1]}{asset.size ? ` · ${formatBytes(asset.size)}` : ''}
            </p>
            <a class="button" href={asset.url} rel="noopener" aria-label={`${packageLabels[asset.kind][0]} paketini indir`}>
              İndir
            </a>
          </article>
        ))}
      </div>
    )}

    <div class="security-note">
      <strong>Dosya güvenliği</strong>
      <p>
        Paketler projenin resmî GitHub Releases sayfasında yayımlanır. Kurulum kullanıcı
        başınadır: yönetici parolası istemez, Program Files'a yazmaz ve mevcut
        veritabanınıza dokunmaz. İndirdiğiniz dosyayı yayımlanan SHA-256 değeriyle
        doğrulamanız önerilir.
      </p>
      <a href="/sorumluluk-sinavi/kilavuz/#dosya-dogrulama">Dosya doğrulama adımları →</a>
    </div>

    <p class="github-fallback">
      Okulda 0.3.0 kurulu ise üzerine 0.4.0 kurun: o numarayla iki farklı paket derlendi,
      hangi içeriği taşıdığı ayırt edilemiyor. Yükseltme önce kaldırmayı gerektirmez ve
      veritabanına dokunmaz.
    </p>
  </section>

  <section class="section safety" id="mevzuat">
    <div>
      <p class="eyebrow">Dayanağı yazılı</p>
      <h2>Kural mevzuattan gelir, koddan değil.</h2>
      <p>
        18 kural tek dosyada tanımlanır ve tek yerde uygulanır: motorun ürettiği plan da
        elle düzenlenen plan da aynı doğrulayıcıdan geçer. Mevzuat değil okul kararı olan
        kurallar kodda böyle etiketlenir.
      </p>
    </div>
    <div class="safety-list">
      <p><strong>Sınav penceresi ve komisyon</strong><span>OKY md.58/2-a — sınavların yapılacağı dönem ve komisyon kuruluşu.</span></p>
      <p><strong>Düzey birleştirme ve gözcü</strong><span>OKY md.58/2-b, 2-c — 30 öğrenci sınırı ve salon başına gözcü.</span></p>
      <p><strong>Hafta sonu ve müdür onayı</strong><span>OKY md.58/2-ç — hafta içi tükenmeden hafta sonuna geçilmez.</span></p>
      <p><strong>Başvuru zorunluluğu</strong><span>OKY md.58/2-d — beklemeli ve devamsız öğrencinin yazılı başvurusu.</span></p>
      <p><strong>İki aşamalı dersler</strong><span>OKY md.58/2-e — yazılı ve uygulama oturumları birlikte taşınır.</span></p>
      <p><strong>Süre ve günlük sınav sayısı</strong><span>ÖDY md.5/1-l ve 5/1-k — sınav süresi ve öğrencinin günlük sınav tavanı.</span></p>
      <p><strong>Çifte rol ve yönetici görevi</strong><span>Karar md.12/2-b, 2-c — aynı sınavda çifte rol yok; yönetici görevi ücretsizdir.</span></p>
      <p><strong>Yıllık görev sayacı</strong><span>Karar md.12/2-a — 12 komisyon / 15 gözcülük sınırı için sayaç tutulur.</span></p>
    </div>
  </section>

  <section class="section updates" id="guncellemeler">
    <div class="section-heading">
      <p class="eyebrow">Güncellemeler</p>
      <h2>Her sürümün ne getirdiğini görün</h2>
    </div>
    <div class="update-layout">
      <div>
        <p class="release-title">
          {release.available
            ? release.name || `Sorumluluk Sınavı ${release.version}`
            : 'İndirilebilir sürüm henüz yayımlanmadı'}
        </p>
        <p class="muted">
          {release.available && releaseDate
            ? releaseDate
            : 'Paketler hazır olduğunda burada görünür.'}
        </p>
      </div>
      <div>
        <p>
          Yeni özellikler, düzeltmeler ve bilinen sınırlar sürüm sayfasında ve depodaki
          değişiklik günlüğünde açıkça yayımlanır.
        </p>
        <a class="text-link" href={release.releaseUrl} rel="noopener">Tüm sürüm notlarını görüntüle →</a>
      </div>
    </div>
  </section>

  <section class="section contact" id="iletisim">
    <div>
      <p class="eyebrow">İletişim</p>
      <h2>Bir sorun veya öneriniz mi var?</h2>
      <p>
        Teknik destek ve geliştirme önerileri için e-posta gönderebilir ya da GitHub
        üzerinde kayıt açabilirsiniz.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="mailto:aalidemirci@gmail.com?subject=Sorumluluk%20Sınavı%20hakkında">E-posta gönder</a>
        <a class="button button-outline" href="https://github.com/aalidemirci/sorumluluk-sinavi/issues" rel="noopener">GitHub Issues</a>
      </div>
    </div>
    <aside class="warning-card">
      <strong>Kişisel veri göndermeyin</strong>
      <p>
        Destek talebine öğrenci/personel adı, T.C. kimlik numarası, e-Okul rapor dosyası,
        üretilmiş evrak, veritabanı, yedek veya ekran görüntüsü eklemeyin. Sorunu kişisel
        ve kurumsal bilgi içermeyen örneklerle anlatın.
      </p>
      <a href="/sorumluluk-sinavi/gizlilik/">Gizlilik ve KVKK bilgilendirmesi →</a>
    </aside>
  </section>
</SSLayout>
